{
  "name": "tols-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for tols: developer tools as a website and a zero-dependency CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arasovic/tols.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "check": "npm run check -w apps/web",
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web"
  }
}
