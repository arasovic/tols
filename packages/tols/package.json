{
  "name": "tols-cli",
  "version": "0.1.0",
  "description": "Dev utilities in one zero-dep CLI: 29 tools to format, encode, hash, generate, convert. Pipe-friendly, --json everywhere.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tols": "bin/tols.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/*.js": "./src/core/*.js",
    "./core/*": "./src/core/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "vitest --run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsqr": "^1.4.0",
    "vitest": "^2.1.9"
  },
  "author": "arasovic",
  "keywords": [
    "cli",
    "developer-tools",
    "utilities",
    "base64",
    "json",
    "yaml",
    "jwt",
    "qrcode",
    "barcode",
    "regex",
    "sql-formatter",
    "markdown",
    "hash",
    "uuid",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arasovic/dev-utilities.git",
    "directory": "packages/tols"
  },
  "homepage": "https://github.com/arasovic/dev-utilities/tree/main/packages/tols#readme",
  "bugs": {
    "url": "https://github.com/arasovic/dev-utilities/issues"
  }
}
